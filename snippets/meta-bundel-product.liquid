       const currentVariant = mainVariants.find(v => v.id == mainVariantId);
       console.log(currentVariant,"currentVariant");
       if (!currentVariant) return;

       document.querySelectorAll('.bundle-product').forEach(bundle => {
         const bundleVariants = JSON.parse(bundle.dataset.variants);
         const selectedOptions = {};


         bundle.querySelectorAll('input[type="radio"]').forEach(radio => {
           const optionName = radio.dataset.optionName.toLowerCase();

           // color
           if (optionName.includes('color') || optionName.includes('colour')) return;

           const mainIndex = currentVariant.options.findIndex(opt => opt === radio.value);
           if (mainIndex !== -1) radio.checked = true;
         });


         bundle.querySelectorAll('input[type="radio"]:checked').forEach(radio => {
           selectedOptions[radio.dataset.optionName] = radio.value;
         });


         const matchedVariant = bundleVariants.find(variant => {
           return variant.options.every(opt => Object.values(selectedOptions).includes(opt));
         });

         if (matchedVariant) {
           const hiddenInput = bundle.querySelector('.product-variant-id');
           const display = bundle.querySelector('.current-variant-id');
           const img = bundle.querySelector('.bundle-product-image');

           if (hiddenInput) hiddenInput.value = matchedVariant.id;
           if (display) display.textContent = matchedVariant.id;
           if (img && matchedVariant.featured_image) img.src = matchedVariant.featured_image.src;
         }
       });
     }


     document.addEventListener('DOMContentLoaded', syncBundleVariants);

     document.addEventListener('change', function (e) {

       if (e.target.closest('variant-selects') || e.target.name === 'id') {
         setTimeout(syncBundleVariants, 50);
       }

       if (e.target.matches('.bundle-product input[type="radio"]')) {
         const bundle = e.target.closest('.bundle-product');
         const bundleVariants = JSON.parse(bundle.dataset.variants);
         const selected = [];

         bundle.querySelectorAll('input[type="radio"]:checked').forEach(r => selected.push(r.value));

         const matchedVariant = bundleVariants.find(v =>
           v.options.every((opt, i) => opt === selected[i])
         );

         if (matchedVariant) {
           const hiddenInput = bundle.querySelector('.product-variant-id');
           const display = bundle.querySelector('.current-variant-id');
           const img = bundle.querySelector('.bundle-product-image');

