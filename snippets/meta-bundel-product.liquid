    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const titles = document.querySelectorAll('.bundle-title');
        const products = document.querySelectorAll('.bundle-product');

        /* ---------- PRODUCT SWITCH ---------- */

        function setActiveProduct(targetId) {
          products.forEach((product) => {
            if (product.id === targetId) {
              product.style.display = 'flex';
            } else {
              product.style.display = 'none';
            }
          });
        }

        if (products.length) {
          setActiveProduct(products[0].id);
        }

        titles.forEach((title) => {
          title.addEventListener('click', function () {
            const targetId = this.dataset.target;

            setActiveProduct(targetId);

            titles.forEach((t) => t.classList.remove('active'));
            this.classList.add('active');
          });
        });

        /* ---------- VARIANT CHANGE ---------- */

        products.forEach((product) => {
          const img = product.querySelector('.variant-image');
          const price = product.querySelector('.bundle-price');
          const Compareprice = product.querySelector('.bundle-compare-price');
          const hiddenInput = product.querySelector('.product-variant-id');

          const checked = product.querySelector("input[type='radio']:checked");

          if (checked) {
            hiddenInput.value = checked.value;

            if (img) img.src = checked.dataset.image;
            if (price) price.innerText = checked.dataset.price;
            if (Compareprice) Compareprice.innerText = checked.dataset.compareprice;
          }

          product.querySelectorAll("input[type='radio']").forEach((radio) => {
            radio.addEventListener('change', function () {
              hiddenInput.value = this.value;

              if (img) img.src = this.dataset.image;
              if (price) price.innerText = this.dataset.price;
              if (Compareprice) Compareprice.innerText = this.dataset.compareprice;
            });
          });
        });

        function setActiveProduct(targetId) {
          products.forEach((product) => {
            const form = product.closest('form');
            const btnDiv = form.querySelector('.product-form__buttons');

            if (product.id === targetId) {
              product.style.display = 'flex';
              if (btnDiv) btnDiv.style.display = 'block';
            } else {
              product.style.display = 'none';
              if (btnDiv) btnDiv.style.display = 'none';
            }
          });
        }

        if (products.length > 0) setActiveProduct(products[0].id);

        titles.forEach((title) => {
          title.addEventListener('click', function () {
            const targetId = this.dataset.target;
            setActiveProduct(targetId);

            titles.forEach((t) => t.classList.remove('active'));
            this.classList.add('active');
          });
        });


      let mainProductVariantTitle = "{{ product.selected_or_first_available_variant.title }}";
      document.addEventListener('change', function(e){
        if(e.target.closest('variant-selects') || e.target.name === 'id'){
          const form = document.querySelector('.product-form form');
          const variantId = form.querySelector('.product-form [name="id"]').value;
          const variantData = {{ product.variants | json }};
          const currentVariant = variantData.find(v => v.id == variantId);
          if(currentVariant){
            mainProductVariantTitle = currentVariant.title;
            {% comment %} console.log(mainProductVariantTitle, "updated title"); {% endcomment %}
          }
        }
      });

      document.querySelectorAll('.bundle-add-to-cart').forEach((button) => {
        button.addEventListener('click', function (e) {
          e.preventDefault();

          const form = this.closest('form');
          const metafieldValue = form.querySelector('.product-variant-id').value;
          {% comment %} console.log(mainProductVariantTitle, "variant title"); {% endcomment %}

          fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: metafieldValue,
              quantity: 1,
              properties: {
                'Size': mainProductVariantTitle
              },
            }),
          })
          .then((res) => res.json())
          .then(() => fetch('/?section_id=cart-drawer'))
          .then((res) => res.text())
          .then((responseText) => {
            const html = new DOMParser().parseFromString(responseText, 'text/html');
            const newDrawer = html.querySelector('cart-drawer');
            const currentDrawer = document.querySelector('cart-drawer');
            if (newDrawer && currentDrawer) {
              currentDrawer.replaceWith(newDrawer);
              newDrawer.open();
            }
          });
        });
      });
      });
    </script>
{% endcomment %}
