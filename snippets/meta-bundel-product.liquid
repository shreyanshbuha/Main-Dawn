<style>
      .swatch-label {
      display: inline-block;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      border: 1px solid #ccc;
      margin-right: 5px;
      cursor: pointer;
      vertical-align: middle;
    }
    .bundle-option input[type="radio"] {
      display: none;
    }
    .bundle-option input[type="radio"]:checked + .swatch-label {
      border: 3px solid #000;
    }
    .del-data-color-variant {
      width: 28px;
      position: absolute;
      top: 12px;
      transform: rotate(-45deg);
      background: black;
  }
  .bundle-product .swatch {
    width: 30px;
  }
  .bundle-product .swatch-input__label{
    margin: 0 3px;
  }
</style>
{% if product.metafields.custom.main_product_dependent_bunch.value != blank %}
{% liquid
  assign option_disabled = true
  if value.available
    assign option_disabled = false
  endif
%}

<div style="border: 1px solid black; padding: 10px; display: flex;">
  <product-form>
    {% form 'product', product, id: 'myForm' %}
      <div class="bundle-variants-wrapper">
        {% for product_bundle in product.metafields.custom.main_product_dependent_bunch.value %}
          <div
            class="bundle-product"
            data-variants="{{ product_bundle.variants | json | escape }}"
            style="margin:10px;text-align:center; position: relative;"
          >
            {% if product_bundle.selected_or_first_available_variant.featured_media != blank %}
            <img
              class="bundle-product-image"
              src="{{ product_bundle.selected_or_first_available_variant.featured_media | image_url: width:300 }}"
              width="150"
              height="150"
            >
            {% else %}
                <img
              class="bundle-product-image"
              src="{{ product_bundle.featured_image | image_url: width:300 }}"
              width="150"
              height="150"
            >
            {% endif %}

            {% for option in product_bundle.options_with_values %}
              {% assign display_name = option.name %}
              {% if option.name == 'Colour' or option.name == 'Color' %}
                {% assign display_name = 'Color' %}
              {% endif %}

              <fieldset
                class="bundle-option"
                  {% if option.name == 'Fabric' or option.name == 'Size' %}
                    style="display:none;"
                  {% endif %}
              >
                <legend>{{ option.name }}</legend>

                {% for value in option.values %}
                  {%- capture input_id -%}
                    {{ section.id }}-{{ option.position }}-{{ forloop.index0 -}}
                  {%- endcapture -%}

                  {%- capture input_name -%}
                    name="{{ option.name }}-{{ product.id }}"
                  {%- endcapture -%}

                  {%- capture input_dataset -%}
                    data-product-url="{{ value.product_url }}"
                    data-option-value-id="{{ value.id }}"
                  {%- endcapture -%}
                  {%- liquid
                    assign swatch_focal_point = null
                    if value.swatch.image
                      assign image_url = value.swatch.image | image_url: width: 50
                      assign swatch_value = 'url(' | append: image_url | append: ')'
                      assign swatch_focal_point = value.swatch.image.presentation.focal_point
                    elsif value.swatch.color
                      assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
                    else
                      assign swatch_value = null
                    endif

                    assign option_disabled = true
                    if value.available
                      assign option_disabled = false
                    endif
                  -%}
                  {%- capture help_text -%}
                    <span class="visually-hidden">{{ escaped_value }}</span>
                    {{ label_unavailable }}
                  {%- endcapture -%}

                  {% if option.name == 'Color' %}
                    {% render 'swatch-input',
                      id: input_id,
                      name: input_name,
                      value: value,
                      swatch: value.swatch,
                      product_form_id: 'product-form',
                      checked: value.selected,
                      visually_disabled: option_disabled,
                      help_text: help_text,
                      additional_props: input_dataset,
                      product_bundle: product_bundle,
                      option_data: option_data,
                      option: option
                    %}
                  {% else %}
                    {% assign variant_for_value = null %}
                    {% for variant in product_bundle.variants %}
                      {% if variant.options contains value %}
                        {% assign variant_for_value = variant %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                    <input
                      type="radio"
                      id="{{ input_id }}"
                     name="{{ option.name }}-{{ product_bundle.selected_or_first_available_variant.id }}"
                      value="{{ value }}"
                      data-product-index="{{ forloop.parentloop.index0 }}"
                      form="{{ product_form_id }}"
                      data-variant-id="{{ variant_for_value.id }}"
                      form="{{ product_form_id }}"
                      {% if value.selected %}
                        checked
                      {% endif %}
                      {% if option_disabled %}
                        class="disabled"
                      {% endif %}
                      data-option-position="{{ option.position }}"
                      data-option-name="{{ option.name }}"
                    >
                    <label for="{{ input_id }}">
                      {{ value -}}
                      {{ label_unavailable }}
                    </label>
                  {% endif %}
                {% endfor %}
              </fieldset>
            {% endfor %}
            <input
              type="hidden"
              name="id"
              class="product-variant-id"
              value="{{ product_bundle.selected_or_first_available_variant.id }}"
            >

            <p>
              Variant ID :
              <span class="current-variant-id">
                {{ product_bundle.selected_or_first_available_variant.id }}
              </span>
            </p>
          </div>
        {% endfor %}

        <div class="product-form__error-message-wrapper" role="alert" hidden>
          <span class="svg-wrapper">
            {{- 'icon-error.svg' | inline_asset_content -}}
          </span>
          <span class="product-form__error-message"></span>
        </div>

        <div class="product-form__buttons">
          {%- liquid
            assign check_against_inventory = true
            if product_bundle.selected_or_first_available_variant.inventory_management != 'shopify' or product_bundle.selected_or_first_available_variant.inventory_policy == 'continue'
              assign check_against_inventory = false
            endif
            if product_bundle.selected_or_first_available_variant.quantity_rule.min > product_bundle.selected_or_first_available_variant.inventory_quantity and check_against_inventory
              assign quantity_rule_soldout = true
            endif
          -%}
          <button
            id="ProductSubmitButton-{{ section_id }}"
            type="submit"
            name="add"
            class=" product-form__submit button button--full-width {% if show_dynamic_checkout %}button--secondary{% else %}button--primary{% endif %}"
             {% if product_bundle.selected_or_first_available_variant.available == false
              or quantity_rule_soldout
            %}
              disabled
            {% endif %}
          >
           <span>
              {%- if product_bundle.selected_or_first_available_variant.available == false or quantity_rule_soldout -%}
                {{ 'products.product.sold_out' | t }}
              {%- else -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- endif -%}
            </span>
            {%- render 'loading-spinner' -%}
          </button>
          {%- if show_dynamic_checkout -%}
            {{ form | payment_button }}
          {%- endif -%}
        </div>
      </div>
    {% endform %}
  </product-form>
</div>


<script>
  document.addEventListener('DOMContentLoaded', function () {
    const mainVariants = {{ product.variants | json }};
    const form = document.querySelector('.product-form form');
    if (!form) return;
    const bundleProducts = document.querySelectorAll('.bundle-product');

    function syncBundles() {
      const mainVariantId = form.querySelector('[name="id"]').value;
      const currentMainVariant = mainVariants.find(v => v.id == mainVariantId);
      if (!currentMainVariant) return;

      bundleProducts.forEach(bundle => {
        const hiddenInput = bundle.querySelector('.product-variant-id');
        const variantIdDisplay = bundle.querySelector('.current-variant-id');
        const variants = JSON.parse(bundle.dataset.variants);
        const inputs = bundle.querySelectorAll('input[type="radio"]');

      
        inputs.forEach(radio => {
          const optionName = radio.dataset.optionName.toLowerCase();
          const optionPosition = parseInt(radio.dataset.optionPosition) - 1;

          if (optionName === 'color' || optionName === 'colour') return;  

          if (currentMainVariant.options[optionPosition] === radio.value) {
            radio.checked = true;
          } else {
            radio.checked = false;
          }
        });

        // update id
        updateBundleVariant(bundle);
      });
    }

    function updateBundleVariant(bundle) {
      const hiddenInput = bundle.querySelector('.product-variant-id');
      const variantIdDisplay = bundle.querySelector('.current-variant-id');
      const img = bundle.querySelector('.bundle-product-image');
      const variants = JSON.parse(bundle.dataset.variants);
      const inputs = bundle.querySelectorAll('input[type="radio"]');

      const selectedOptions = [];
      inputs.forEach(input => {
        if (input.checked) selectedOptions[input.dataset.optionPosition - 1] = input.value;
      });

      const matchedVariant = variants.find(v =>
        v.options.every((opt, idx) => opt === selectedOptions[idx])
      );

      if (matchedVariant) {
        hiddenInput.value = matchedVariant.id;
        if (variantIdDisplay) variantIdDisplay.textContent = matchedVariant.id;
        if (img && matchedVariant.featured_image) img.src = matchedVariant.featured_image.src;
      }
    }

    syncBundles();

    // main product sync
    form.querySelector('[name="id"]').addEventListener('change', syncBundles);

    bundleProducts.forEach(bundle => {
      const inputs = bundle.querySelectorAll('input[type="radio"]');

      inputs.forEach(input => {
        input.addEventListener('change', (e) => {
          e.stopPropagation();  
          updateBundleVariant(bundle);
        });

        const label = bundle.querySelector(`label[for="${input.id}"]`);
        if (label) {
          label.addEventListener('click', (e) => {
            e.preventDefault();  
            input.checked = true;
            updateBundleVariant(bundle);
          });
        }
      });
    });
  });
</script>
{% endif %}



